# =============================================================================
# BAUST Campus - Docker environment
# Copy to `.env.docker`, fill in the secrets, then: docker compose up -d --build
# Read by compose.yml only; the project's .env is for `php artisan serve`.
# =============================================================================

# --- Application ---
APP_ENV=production
APP_DEBUG=false
# Local for now. When the domain is chosen: https://<your-domain>
APP_URL=http://localhost:8088
# Generate once with: php artisan key:generate --show
APP_KEY=base64:REPLACE_ME
LOG_LEVEL=warning

# --- Database (MySQL 8.4) ---
DB_DATABASE=baust_campus
DB_USERNAME=baust_campus_user
DB_PASSWORD=REPLACE_ME
# Used by the mysql container on first start only (must match the DB_* above)
MYSQL_DATABASE=baust_campus
MYSQL_USER=baust_campus_user
MYSQL_PASSWORD=REPLACE_ME
MYSQL_ROOT_PASSWORD=REPLACE_ME

# --- Laravel drivers ---
SESSION_DRIVER=database
# Set to true once the site is served over https (tunnel/domain)
SESSION_SECURE_COOKIE=false
QUEUE_CONNECTION=database
CACHE_STORE=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Mail (defaults to log driver) ---
MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@baust.edu.bd

# --- Cloudflare Tunnel (only used with: docker compose --profile tunnel up -d) ---
# Token from: Zero Trust > Networks > Tunnels > (this tunnel) > Install connector.
# Public Hostname `<your-domain>` -> Service `http://baust_campus_app:80`.
TUNNEL_TOKEN=
